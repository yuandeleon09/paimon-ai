# .env.example - Paimon AI Multi-Agent Assistant Configuration
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
OBSIDIAN_VAULT=./Obsidian-Brain

# Local Task Attempt Budget (Safety Cap, Default: 8, Max: 12)
MAX_MODEL_CALLS_PER_TASK=8
MAX_REVISIONS=1

# Phase 1: Stability, Jittered Backoff & Recovery
PAIMON_MAX_TASK_ATTEMPTS=8
PAIMON_RATE_LIMIT_RETRIES=2
PAIMON_TASK_RECOVERY_ON_STARTUP=true
PAIMON_IDEMPOTENCY_CACHE_MINUTES=60

# Selective Memory & Quality Thresholds
MAX_RETRIEVED_MEMORIES=5
MAX_MEMORY_CONTEXT_TOKENS=700
MEMORY_MIN_SCORE=7
MAX_MEMORY_WORDS=100
MAX_CANDIDATE_MEMORIES_PER_TASK=2

# Multi-Agent Team Collaboration
MAX_COLLABORATORS=3
MAX_IDEAS_PER_AGENT=2
MAX_TEAM_REVISIONS=1

# Storage & Privacy Policies
RUN_METADATA_RETENTION_DAYS=14
LEARNING_MODE=review
ENABLE_WEB_RESEARCH=false
ENABLE_CODE_EXECUTION=false
ENABLE_SCHEDULED_EVALUATIONS=false
